{
  "name": "hallway",
  "version": "0.1.0",
  "description": "The front door for everything you vibe-coded on a random port: a local-only dashboard of every web server on your machine, with health, memorable hostnames and bookmarks.",
  "keywords": [
    "dashboard",
    "localhost",
    "dev-server",
    "reverse-proxy",
    "launchd",
    "systemd",
    "ai-agents",
    "coding-agents",
    "claude-code",
    "local-first"
  ],
  "homepage": "https://github.com/edspencer/hallway#readme",
  "bugs": {
    "url": "https://github.com/edspencer/hallway/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edspencer/hallway.git"
  },
  "license": "MIT",
  "author": "Ed Spencer",
  "type": "module",
  "bin": {
    "hallway": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "dist/shared/",
    "dist/web/",
    "AGENT-GUIDE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "node -e \"fs.rmSync('dist/server',{recursive:true,force:true});fs.rmSync('dist/shared',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n api,web \"HALLWAY_DEV=1 PORT=$HALLWAY_API_PORT tsx watch server/cli.ts serve\" \"vite\"",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "hallway": "tsx server/cli.ts",
    "sync:guide": "tsx scripts/sync-guide.ts",
    "check:nul": "node scripts/check-no-nul-bytes.mjs",
    "prepack": "npm run build",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only --ignore-scripts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "chokidar": "^5.0.0",
    "hono": "^4.13.13",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
