---
/**
 * Overrides Starlight's Banner (astro.config.mjs → `components`) so that EVERY docs page says where the milestones
 * stand (v0 and v1 are released, and v2's software; v2's run on a real Mac is not done), without each page having to
 * remember a `banner:` frontmatter entry. A page that does set one gets its own instead. Reword it when the run on a
 * real Mac is done, or when a new milestone starts.
 */
const { banner } = Astro.locals.starlightRoute.entry.data;
const content =
	banner?.content ??
	'<strong>Hallway is out</strong> (<code>npm i -g hallway</code>): <span class="b-ms">v0</span>, <span class="b-ms">v1</span> and <span class="b-ms">v2</span> have shipped, apart from checking it all on a real Mac. See the <a href="/roadmap/">roadmap</a>.';
---

<div class="sl-banner" data-pagefind-ignore set:html={content} />

<style>
	@layer starlight.core {
		.sl-banner {
			padding: 0.55rem var(--sl-nav-pad-x);
			background-color: var(--sl-color-accent-low);
			color: var(--sl-color-gray-2);
			border-bottom: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-sm);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
		}
		.sl-banner :global(a) {
			color: var(--sl-color-text-accent);
		}
		.sl-banner :global(strong) {
			color: var(--sl-color-white);
		}
		.sl-banner :global(code),
		.sl-banner :global(.b-ms) {
			font-family: var(--sl-font-mono);
			font-size: 0.9em;
		}
	}
</style>
