---
/**
 * Overrides Starlight's Banner (astro.config.mjs → `components`) so that EVERY docs page says what the badges mean
 * (v0 is released; v1 and v2 are upcoming), without each page having to remember a `banner:` frontmatter entry. A page
 * that does set one gets its own instead. Reword it when v1 ships.
 */
const { banner } = Astro.locals.starlightRoute.entry.data;
const content =
	banner?.content ??
	'<strong>v0 is out</strong> (<code>npm i -g hallway</code>). Features marked <span class="b-ms">v0</span> are available now; <span class="b-ms">v1</span> and <span class="b-ms">v2</span> are upcoming: see the <a href="/roadmap/">roadmap</a>.';
---

<div class="sl-banner" data-pagefind-ignore set:html={content} />

<style>
	@layer starlight.core {
		.sl-banner {
			padding: 0.55rem var(--sl-nav-pad-x);
			background-color: var(--sl-color-accent-low);
			color: var(--sl-color-gray-2);
			border-bottom: 1px solid var(--sl-color-hairline);
			font-size: var(--sl-text-sm);
			line-height: var(--sl-line-height-headings);
			text-align: center;
			text-wrap: balance;
		}
		.sl-banner :global(a) {
			color: var(--sl-color-text-accent);
		}
		.sl-banner :global(strong) {
			color: var(--sl-color-white);
		}
		.sl-banner :global(code),
		.sl-banner :global(.b-ms) {
			font-family: var(--sl-font-mono);
			font-size: 0.9em;
		}
	}
</style>
