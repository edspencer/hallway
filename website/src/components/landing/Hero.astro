---
/**
 * Hero — the fold.
 *
 * Two columns on desktop, as on Local Review's and Paddock's sites: prose and
 * buttons on the left, the terminal card on the right. Under the terminal, where
 * Local Review has its demo video, Hallway has a drawn mock-up of the planned
 * dashboard (Mock.astro), tagged as such: no real captures exist yet. On
 * mobile the columns stack.
 */
import Icon from './Icon.astro';
import CommandTabs from './CommandTabs.astro';
import HeroBackdrop from './HeroBackdrop.astro';
import Mock from './Mock.astro';
import { hero, HERO_LINKS } from './copy';
---

<section class="hero">
	<HeroBackdrop />

	<div class="container hero-inner">
		<div class="hero-copy">
			<p class="eyebrow">{hero.eyebrow}</p>
			<h1 class="h1">{hero.title}</h1>
			<p class="lede lede--first">{hero.lede}</p>
			<p class="lede">{hero.body}</p>

			<div class="btn-row hero-btns">
				{
					HERO_LINKS.map((l) => (
						<a
							class={`btn ${l.primary ? 'btn--primary' : ''}`}
							href={l.href}
							rel={l.href.startsWith('http') ? 'noopener' : undefined}
						>
							<Icon name={l.icon as any} />
							{l.text}
						</a>
					))
				}
			</div>
		</div>

		<div class="hero-aside">
			<CommandTabs idPrefix="hero" />
			<Mock
				name="dashboard"
				alt="Mock-up of the planned Hallway dashboard: a header reading Hallway, my-laptop, 3 up, 1 down, then six app cards, each a door with its port on a brass plate, a name, a localhost address, a 24-hour uptime bar and a state: three healthy, two stopped and one down"
			/>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		align-items: center;
		/* Not 100svh: tall enough to own the fold and short enough that the next
		   section peeks, which is what invites the scroll. */
		min-height: min(92svh, 54rem);
		padding-block: 8rem 4.5rem;
		isolation: isolate;
	}

	.hero-inner {
		position: relative;
		z-index: 1;
		display: grid;
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	@media (min-width: 940px) {
		.hero-inner {
			grid-template-columns: 1fr 1fr;
		}
	}

	/* Smaller than the shared .h1: our headline is a whole sentence. */
	.hero-copy .h1 {
		font-size: clamp(2.3rem, 4.6vw, 3.4rem);
		margin-bottom: 1.6rem;
	}

	.lede--first {
		margin-top: 0;
	}

	.lede + .lede {
		margin-top: 1rem;
	}

	.hero-btns {
		margin-top: 2.25rem;
	}

	.hero-btns .btn {
		padding-inline: 1.1rem;
	}

	.hero-aside {
		display: flex;
		flex-direction: column;
		gap: 1.1rem;
		min-width: 0;
	}
</style>
